  m_Script: {fileID: 11500000, guid: 3d6370e5bcfb7e34795c78d56dc3eb65, type: 3}
  m_Name: TutorialTanques
  m_EditorClassIdentifier: Assembly-CSharp::TutorialSequence
  tutorialId: tut_intro
  moment: 0
  pauseGameWhileOpen: 1
  showOnlyOnce: 1
  steps:
  - speakerOrTitle: "Operario n\xBA91167 "
    message: "Que pasa fiera. soy el operario n\xBA 91167 y manejo mi poderoso tanque y te voy a ense\xF1ar como usarlo impresionantemente bien "
  - speakerOrTitle: "Operario n\xBA91167 "
    message: "Lo primero que debes saber es que me puedo mover 1 casilla m\xE1s que el soldadiducho de al lado"
  - speakerOrTitle: "Soldado n\xBA 42070"
    message: "Oye eso me ha dolido, aunque es cierto que apenas puedo hacer da\xF1o a los tanques, pero no te olvides de m\xED, todavia puedes moverme y usarme para atacar"
  - speakerOrTitle: "Operario n\xBA91167"
    message: "Bueno, volviendo a lo importante, tenemos un tanque enemigo enfrente, \xBFRecuerdas como mover verdad? Llevame hasta estar a quemarropa del enemigo, un disparo que nunca falla es el golpe abocajarro"
